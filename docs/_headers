/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# Game code + shared stylesheets change often — always revalidate so fixes
# reach players immediately (a 304 when nothing changed keeps it cheap).
/assets/games/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/archive.css
  Cache-Control: public, max-age=0, must-revalidate

# The Virtual Museum is an entry point, not content: keep it and its data out of search results.
/museum.html
  X-Robots-Tag: noindex, follow
/museum/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=0, must-revalidate
/assets/vendor/three/*
  Cache-Control: public, max-age=604800
