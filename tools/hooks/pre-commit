#!/bin/sh
# Opt-in pre-commit hook: runs the originality check on staged chapter, theme and
# Vault markdown. Install with:  git config core.hooksPath tools/hooks
# (see tools/hooks/README.md). Skip once with:  git commit --no-verify

files=$(git diff --cached --name-only --diff-filter=AMR | grep -E '^(eras|themes|vault)/.+\.md$')
[ -z "$files" ] && exit 0

if [ ! -d sources/baseline/shingles ]; then
  echo "originality: no local baseline (sources/baseline/shingles). Trying to build it for the staged files..."
  # shellcheck disable=SC2086
  node tools/build-originality-baseline.js $files || true
fi

# shellcheck disable=SC2086
node tools/originality-check.js $files
status=$?
if [ $status -ne 0 ]; then
  echo "originality: commit stopped. Rewrite the flagged passages in your own words, or quote them with a citation."
fi
exit $status
