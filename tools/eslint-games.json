{
  "root": true,
  "env": { "browser": true, "es2021": true, "node": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "script" },
  "globals": {
    "ArchiveGames": "writable",
    "ARCHIVE": "readonly",
    "PLATE_ART": "readonly",
    "PLATES": "readonly",
    "EMBLEMS": "readonly",
    "FIGHTER_MOVES": "writable",
    "CHAPTERS": "readonly",
    "DOMMatrix": "readonly",
    "Path2D": "readonly"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "off"
  }
}
